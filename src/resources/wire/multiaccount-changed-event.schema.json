{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cdn.jsdelivr.net/npm/@shieldlabs-ai/openapi@1/dist/schemas/multiaccount-changed-event.schema.json",
  "title": "ShieldLabs multi-account group webhook event",
  "type": "object",
  "description": "An immutable opt-in notification of a complete multi-account group transition.",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "schema_version", "site_id", "created_at", "data"],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$",
      "description": "Stable logical event ID. Delivery retries preserve this ID and the signed body."
    },
    "event_type": {
      "const": "hre.multi_account.changed"
    },
    "schema_version": {
      "const": "2026-10-07"
    },
    "site_id": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "$ref": "#/$defs/Rfc3339Timestamp"
    },
    "data": {
      "$ref": "#/$defs/MultiaccountChangedData"
    }
  },
  "$defs": {
    "MultiaccountChangedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "domain",
        "action",
        "status",
        "detected",
        "level",
        "cluster_id",
        "revision",
        "previous_revision",
        "user_hids",
        "added_user_hids",
        "removed_user_hids",
        "users_count",
        "members_complete",
        "evaluated_at",
        "rules_version",
        "source",
        "evidence_summary"
      ],
      "properties": {
        "kind": {
          "const": "multi_account"
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "enum": ["detected", "updated", "resolved"]
        },
        "status": {
          "const": "evaluated",
          "description": "The result comes from a complete, verified detector source cut. Pending or unavailable work does not produce this event."
        },
        "detected": {
          "type": "boolean"
        },
        "level": {
          "type": ["string", "null"],
          "enum": ["medium", "high", null]
        },
        "cluster_id": {
          "type": "string",
          "format": "uuid",
          "description": "Persistent site-qualified group identity. Unambiguous expansion or contraction preserves this ID; ambiguous split/merge starts new identities."
        },
        "revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$",
          "description": "Publication version of this transition, as a decimal string to preserve UInt64 precision."
        },
        "previous_revision": {
          "type": ["string", "null"],
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "description": "Previous transition version while the group was active; null for a newly detected or reappearing group."
        },
        "user_hids": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "description": "Complete sorted group membership. Users from another site are never included. This list is not truncated.",
          "items": {
            "type": "string",
            "minLength": 1,
            "not": {
              "enum": ["anonymous", "-1", "fail", "00000000-0000-0000-0000-000000000000"]
            }
          }
        },
        "added_user_hids": {
          "type": "array",
          "uniqueItems": true,
          "description": "Sorted members added since the previous transition; all current members for detected.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "removed_user_hids": {
          "type": "array",
          "uniqueItems": true,
          "description": "Sorted members removed since the previous transition; all previous members for resolved.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "users_count": {
          "type": "integer",
          "minimum": 3,
          "description": "Equal to the length of user_hids."
        },
        "members_complete": {
          "const": true
        },
        "evaluated_at": {
          "$ref": "#/$defs/Rfc3339Timestamp"
        },
        "rules_version": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["publication_epoch", "publication_version", "coverage_id"],
          "properties": {
            "publication_epoch": {
              "const": "multiaccount-v1"
            },
            "publication_version": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$",
              "description": "The exact immutable publication containing this result and event."
            },
            "coverage_id": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "description": "Immutable binding to the trusted source completeness proof."
            }
          }
        },
        "evidence_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["basis_types", "rules", "detail_truncated"],
          "properties": {
            "basis_types": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "rules": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "detail_truncated": {
              "type": "boolean",
              "description": "Whether the detector's underlying detailed evidence was truncated. Group membership remains complete."
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "detected"
              }
            },
            "required": ["action"]
          },
          "then": {
            "additionalProperties": true,
            "properties": {
              "previous_revision": {
                "type": "null"
              }
            }
          },
          "else": {
            "additionalProperties": true,
            "properties": {
              "previous_revision": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "resolved"
              }
            },
            "required": ["action"]
          },
          "then": {
            "additionalProperties": true,
            "properties": {
              "detected": {
                "const": false
              },
              "level": {
                "type": "null"
              }
            }
          },
          "else": {
            "additionalProperties": true,
            "properties": {
              "detected": {
                "const": true
              },
              "level": {
                "type": "string",
                "enum": ["medium", "high"]
              }
            }
          }
        }
      ]
    },
    "Rfc3339Timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "description": "RFC 3339 timestamp in UTC with up to 9 fractional digits (trailing zeros trimmed), for example `2026-09-30T12:34:57.482913041Z`. Parse it with a parser that accepts nanoseconds.",
      "examples": ["2026-09-30T12:34:57.482913041Z", "2026-09-30T12:34:56Z"]
    }
  }
}
