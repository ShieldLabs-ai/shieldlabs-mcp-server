// Local tests only. Configure your own OAuth/account backend before self-hosting.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shieldlabs-mcp-local",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": false,
  "vars": {
    "SHIELDLABS_PUBLIC_ORIGIN": "https://mcp.example.test",
    "SHIELDLABS_AUTH_ISSUER": "https://account.example.test",
    "SHIELDLABS_PORTAL_URL": "https://account.example.test",
  },
  "ratelimits": [
    {
      "name": "RL_TOKEN",
      "namespace_id": "1",
      "simple": {
        "limit": 120,
        "period": 60,
      },
    },
    {
      "name": "RL_ANON",
      "namespace_id": "2",
      "simple": {
        "limit": 60,
        "period": 60,
      },
    },
    {
      "name": "RL_TOKEN_CHECK",
      "namespace_id": "3",
      "simple": {
        "limit": 300,
        "period": 60,
      },
    },
  ],
  "env": {
    "dev": {
      "name": "shieldlabs-mcp-local",
      "workers_dev": false,
      "vars": {
        "SHIELDLABS_PUBLIC_ORIGIN": "https://mcp.example.test",
        "SHIELDLABS_AUTH_ISSUER": "https://account.example.test",
        "SHIELDLABS_PORTAL_URL": "https://account.example.test",
      },
      "ratelimits": [
        {
          "name": "RL_TOKEN",
          "namespace_id": "1",
          "simple": {
            "limit": 120,
            "period": 60,
          },
        },
        {
          "name": "RL_ANON",
          "namespace_id": "2",
          "simple": {
            "limit": 60,
            "period": 60,
          },
        },
        {
          "name": "RL_TOKEN_CHECK",
          "namespace_id": "3",
          "simple": {
            "limit": 300,
            "period": 60,
          },
        },
      ],
    },
  },
}
